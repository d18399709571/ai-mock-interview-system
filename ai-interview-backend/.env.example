# JWT signing key is required: generate a private value; no shared default is provided.
# Public configuration example
# Created from variable NAMES only; original values were not copied.
# Set passwords, secrets and API keys in your private .env.
# Development defaults are examples; adjust for your environment.

ENV=development
PROJECT_NAME=Demo API
API_V1_STR=/api/v1
API_PORT=8006
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
USE_HTTP_PROXY=false
HTTP_PROXY=
HTTPS_PROXY=
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Demo
MAIL_ENCRYPTION=none
BREVO_API_KEY=
BREVO_EMAIL_FROM=noreply@example.com
BREVO_EMAIL_FROM_NAME=Demo
ADMIN_EMAIL=admin@example.com
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT=https://s3.amazonaws.com
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
